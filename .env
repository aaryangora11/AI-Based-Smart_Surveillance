# Database (Postgres / Docker container: smart-surveillance-postgres)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=smartuser
DB_PASS=changeme
DB_NAME=smartdb
DATABASE_URL=postgresql://smartuser:changeme@127.0.0.1:5432/smartdb

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# MinIO Configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=surveillance
MINIO_SECURE=false

# JWT Config
JWT_SECRET_KEY=mysecretkey
ACCESS_TOKEN_EXPIRE_MINUTES=60
